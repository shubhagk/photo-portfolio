{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://photo-portfolio.vetinwild.workers.dev/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://photo-portfolio.vetinwild.workers.dev/media/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
