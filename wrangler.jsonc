{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "photo-portfolio",
  "main": "functions/api/[[path]].js",
  "compatibility_date": "2026-11-02",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "photo-portfolio",
      "database_id": "713dd915-b044-4a3a-bdd6-cbc8995151a0",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "photo-portfolio-images"
    }
  ]
}
